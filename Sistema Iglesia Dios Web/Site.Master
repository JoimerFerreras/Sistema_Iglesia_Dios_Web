</head>

<body onload="asignarEnlace()" class="fondo">

    <telerik:RadFormDecorator runat="server" Skin="Bootstrap" RenderMode="Lightweight" Visible="false" />
    <form runat="server">

        <asp:ScriptManager runat="server" EnablePageMethods="true">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="menuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/menuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <asp:ScriptReference Assembly="Telerik.Web.UI" Name="Telerik.Web.UI.Common.Core.js"></asp:ScriptReference>
                <asp:ScriptReference Assembly="Telerik.Web.UI" Name="Telerik.Web.UI.Common.jQuery.js"></asp:ScriptReference>
                <asp:ScriptReference Assembly="Telerik.Web.UI" Name="Telerik.Web.UI.Common.jQueryInclude.js"></asp:ScriptReference>
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>
        <!--wrapper_1 start-->
        <div class="wrapper_1" id="ContenedorPrincipal">
            <!--header_1 menu_1 start-->
            <div class="header_1">
                <div class="header_1-menu_1">
                    <div class="title_1">Iglesia de Dios <span style="color: #108df7">La 33</span></div>
                    <div class="sidebar_1-btn_1" id="BotonMenu">
                        <i class="fas fa-bars"></i>
                    </div>
                    <asp:Label runat="server" ID="lblNombrePantalla" Text="[Nombre Pantalla]" ClientIDMode="Static" Style="position: absolute; top: 18px; left: 325px; font-size: 22px; font-weight: bold;"></asp:Label>

                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <div id="divContenedorInfoUsuario" class="dropdown-toggle contenedor-boton-usuario" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-circle-user" style="font-size: 40px; color: #2F323A; margin-right: 8px;"></i>
                                <div style="margin-right: 15px;">
                                    <asp:Label runat="server" ID="lblNombreUsuario" Style="display: block; font-weight: bold;">Usuario (Offline)</asp:Label>
                                    <asp:Label runat="server" ID="lblRolUsuario" Style="display: block; font-size: 12px;">Rol de usuario (Offline)</asp:Label>
                                </div>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-lg-end">
                                <li><a class="dropdown-item" href="#"><i class="fa-regular fa-address-book" style="padding-right: 10px;"></i>Ver información de perfil</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fa-solid fa-key" style="padding-right: 10px;"></i>Cambiar mi contraseña</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item boton-cerrar-sesion" id="btnCerrarSesion" onclick="return CerrarSesionAlert(this);" href="#"><i class="fa-solid fa-right-from-bracket" style="padding-right: 10px;"></i>Cerrar sesión</a></li>
                            </ul>
                        </div>


                        <a href="#" id="btnNotificaciones" class="icon-btn boton-notificacion" onclick="abrirPanelNotificaciones()" style="position: relative; box-shadow: 0px 1px 10px rgba(0,0,0,0.2); padding: 14px 18px 14px 18px; background-color: white; border-radius: 10px; color: #2F323A">
                            <i class="fa-solid fa-bell fa-lg" style="margin-bottom: 10px;"></i><span runat="server" id="badgeNotificaciones" class="badge-nueva-boton" style="display: none;"></span>
                        </a>
                    </div>

                </div>
            </div>
            <!--header_1 menu_1 end-->
            <!--sidebar_1 start-->
            <div class="sidebar_1" id="MenuLateral">
                <div class="sidebar_1-menu_1" runat="server" id="divMenuFunciones">
                </div>
            </div>
            <!--sidebar_1 end-->
            <!--main container start-->
            <div class="main-container_1">
                <%--<div class="container body-content">--%>
                <div>
                    <asp:UpdatePanel ID="upPrincipal" runat="server" UpdateMode="Always">
                        <ContentTemplate>
                            <asp:ContentPlaceHolder ID="MainContent" runat="server">
                            </asp:ContentPlaceHolder>
                        </ContentTemplate>
                    </asp:UpdatePanel>
                </div>
            </div>
            <!--main container end-->
        </div>
        <!--wrapper_1 end-->

        <div id="customOverlay" class="custom-overlay" onclick="cerrarPanelNotificaciones()"></div>

        <div id="panelNotificaciones" class="custom-panel">
            <div class="panel-header">
                <h5>Notificaciones</h5>

                <div class="d-flex align-items-center gap-2">
                    <asp:UpdatePanel runat="server" UpdateMode="Conditional">
                        <ContentTemplate>
                            <button runat="server" id="btnEliminarTodas" class="btn btn-sm btn-outline-danger" onserverclick="EliminarTodasNotificaciones_Click" type="button">
                                <i class="fa-solid fa-trash-can" style="margin-right: 5px;"></i>Borrar todo
                            </button>

                        </ContentTemplate>
                    </asp:UpdatePanel>

                    <button type="button" id="btnCerrarPanelNotificaciones" onclick="cerrarPanelNotificaciones()" class="btn-close"></button>
                </div>
            </div>

            <asp:UpdatePanel ID="upNotificaciones" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="true">
                <ContentTemplate>
                    <div class="panel-body" id="divContenedorNotificaciones" runat="server">
                    </div>
                </ContentTemplate>
            </asp:UpdatePanel>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>


<style>
  :root { --brand:#2563eb; --bg-soft:#f8fafc; --text-muted:#6b7280; }
  /* ----- Modal look & feel ----- */
  .modal-whatsnew .modal-dialog { max-width: 1000px; }
  .modal-whatsnew .modal-content { border:0; border-radius:20px; }
  .modal-whatsnew .modal-body { padding: 0; }

  /* ----- STEP 1 (hero) ----- */
  .wn-hero {
    padding: 64px 32px;
    background:
      radial-gradient(1200px 600px at 70% -30%, rgba(37,99,235,.10), transparent 60%),
      linear-gradient(180deg, #ffffff 0%, #f5f7fb 100%);
    text-align:center;
    border-bottom:1px solid #eef2f7;
  }
  .wn-hero .badge-version {
    background: rgba(37,99,235,.1);
    color: var(--brand);
    font-weight:700;
    border-radius: 999px;
    padding: .5rem 1rem;
  }
  .wn-hero h1 {
    font-weight: 800;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    letter-spacing:.2px;
  }
  .wn-hero p { color:var(--text-muted); max-width:720px; margin: 12px auto 0; }
  .wn-hero .cta {
    margin-top: 28px;
    padding: .85rem 1.4rem;
    font-weight: 700;
    box-shadow: 0 10px 20px rgba(37,99,235,.15);
  }

  /* ----- STEP 2 (layout VS-style) ----- */
  .wn-wrap { display:grid; grid-template-columns: 260px 1fr; min-height: 60vh; }
  .wn-sidebar {
    background: linear-gradient(180deg, #ffffff, #f7f9fc);
    border-right:1px solid #edf1f7;
    padding: 20px;
  }
  .wn-sidebar .nav-link {
    color:#111827; border-radius:12px; padding:.6rem .8rem; font-weight:600;
  }
  .wn-sidebar .nav-link small { color:var(--text-muted); font-weight:500; }
  .wn-sidebar .nav-link:hover { background:#eef2ff; }
  .wn-sidebar .nav-link.active {
    background:#e5edff; color:#0f172a; position:relative;
  }
  .wn-sidebar .nav-link.active::before{
    content:""; position:absolute; inset:0; width:4px; left:-6px; border-radius:6px;
    background:var(--brand);
  }

  .wn-content { padding: 28px 28px 16px; background:#fff; }
  .wn-section-title { font-weight:800; margin-bottom: 16px; }
  .feature-card {
    border:1px solid #eef2f7; border-radius:16px; overflow:hidden; height:100%;
    background: linear-gradient(180deg,#ffffff, #fbfcfe);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .feature-card:hover { transform: translateY(-2px); box-shadow:0 12px 24px rgba(2,6,23,.06); }
  .feature-media { aspect-ratio: 16/9; object-fit:cover; width:100%; }
  .feature-body { padding:16px 16px 18px; }
  .feature-body .chip {
    display:inline-flex; align-items:center; gap:.35rem;
    font-size:.78rem; font-weight:700; color:#065f46;
    background:#dcfce7; border-radius:999px; padding:.25rem .6rem;
  }
  .feature-body .chip.warn { background:#fff7ed; color:#9a3412; }
  .muted { color: var(--text-muted); }

  /* Footer buttons */
  .wn-footer { border-top:1px solid #edf1f7; background:#fff; padding:12px 20px; }


  /* 🔧 Redondeado real del modal (y recorte del contenido interno) */
.modal-whatsnew { 
  --bs-modal-border-radius: 22px;          /* Bootstrap 5 var */
}
.modal-whatsnew .modal-dialog {
  overflow: hidden;                         /* evita “sangrado” de fondos internos */
  border-radius: 22px;                      /* fallback */
}
.modal-whatsnew .modal-content {
  border: 0;
  border-radius: 22px;                      /* asegura el radio en la capa correcta */
  overflow: hidden;                         /* recorta gradientes/imagenes del body/header */
  background-clip: padding-box;             /* corrige halos en algunos navegadores */
}


</style>

<!-- Modal -->
<div class="modal fade modal-whatsnew" id="modalNovedades" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">

      <!-- STEP 1: HERO -->
      <div id="step-hero" class="wn-hero">
        <div class="mb-2">
          <span class="badge-version">
            <i class="bi bi-stars me-1"></i> Novedades de la nueva versión · <strong>v1.0.0</strong>
          </span>
        </div>
        <h1><i class="bi bi-rocket-takeoff-fill me-2 text-primary"></i>Lanzamiento con mejoras clave</h1>
        <p>Conoce los cambios más importantes: métricas por mes, exportaciones, panel de notificaciones y optimizaciones de rendimiento.</p>
        <button id="btnGo" class="btn btn-primary cta">
          Ver qué hay de nuevo <i class="bi bi-arrow-right-short fs-5"></i>
        </button>
      </div>

      <!-- STEP 2: WHAT'S NEW (VS-style) -->
      <div id="step-content" class="d-none">
        <div class="wn-wrap">

          <!-- Sidebar -->
          <aside class="wn-sidebar">
            <nav class="nav nav-pills flex-column" id="wnTabs" role="tablist">
              <a class="nav-link active" data-bs-toggle="pill" href="#wn-about" role="tab">
                Acerca de esta versión <br><small>Resumen general</small>
              </a>
              <a class="nav-link" data-bs-toggle="pill" href="#wn-charts" role="tab">
                Gráficos & Reportes <br><small>Ingresos / Egresos</small>
              </a>
              <a class="nav-link" data-bs-toggle="pill" href="#wn-notifs" role="tab">
                Notificaciones <br><small>Panel off-canvas</small>
              </a>
              <a class="nav-link" data-bs-toggle="pill" href="#wn-perf" role="tab">
                Rendimiento <br><small>SQL +28%</small>
              </a>
            </nav>
          </aside>

          <!-- Content -->
          <section class="wn-content">
            <div class="tab-content">

              <!-- About -->
              <div class="tab-pane fade show active" id="wn-about" role="tabpanel">
                <h3 class="wn-section-title">Acerca de esta versión</h3>
                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="feature-card">
                      <img class="feature-media" src="https://images.unsplash.com/photo-1551281044-8b147f1e5910?q=80&w=1200&auto=format&fit=crop" alt="Acerca">
                      <div class="feature-body">
                        <span class="chip"><i class="bi bi-patch-check-fill"></i> Estable</span>
                        <h5 class="mt-2 mb-1">Mejoras de calidad de vida</h5>
                        <p class="muted mb-0">Interfaz más limpia, etiquetas de meses en español y formatos de moneda locales (es-DO).</p>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="feature-card">
                      <img class="feature-media" src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?q=80&w=1200&auto=format&fit=crop" alt="Acerca 2">
                      <div class="feature-body">
                        <span class="chip warn"><i class="bi bi-lightning-charge-fill"></i> Atención</span>
                        <h5 class="mt-2 mb-1">Cambios menores de configuración</h5>
                        <p class="muted mb-0">Asegúrate de revisar permisos y limpiar caché después de actualizar.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Charts & Reports -->
              <div class="tab-pane fade" id="wn-charts" role="tabpanel">
                <h3 class="wn-section-title">Gráficos & Reportes</h3>
                <div class="row g-3">
                  <div class="col-md-7">
                    <div class="feature-card">
                      <img class="feature-media" src="https://picsum.photos/seed/chart/1200/675" alt="Charts">
                      <div class="feature-body">
                        <span class="chip"><i class="bi bi-bar-chart-line"></i> Nuevo</span>
                        <h5 class="mt-2 mb-1">Ingresos, Egresos y Neto (últimos 3 meses)</h5>
                        <p class="muted mb-0">Cálculo independiente por mes, soporte para meses sin movimientos y etiquetas “Junio, Julio, Agosto”.</p>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-5">
                    <div class="feature-card h-100">
                      <img class="feature-media" src="https://picsum.photos/seed/report/800/450" alt="Reports">
                      <div class="feature-body">
                        <span class="chip"><i class="bi bi-filetype-xls"></i> Exportar</span>
                        <h5 class="mt-2 mb-1">Descarga a Excel / PDF</h5>
                        <p class="muted mb-0">Exporta tus listados con un clic desde la barra de acciones.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Notifications -->
              <div class="tab-pane fade" id="wn-notifs" role="tabpanel">
                <h3 class="wn-section-title">Panel de notificaciones</h3>
                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="feature-card">
                      <img class="feature-media" src="https://picsum.photos/seed/notify1/1200/675" alt="Notifs">
                      <div class="feature-body">
                        <span class="chip"><i class="bi bi-bell-fill"></i> Off-canvas</span>
                        <h5 class="mt-2 mb-1">Avisos en tiempo real</h5>
                        <p class="muted mb-0">Panel lateral personalizable con lectura rápida, filtros y enlaces a módulos.</p>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="feature-card">
                      <img class="feature-media" src="https://picsum.photos/seed/notify2/1200/675" alt="Notifs">
                      <div class="feature-body">
                        <span class="chip"><i class="bi bi-shield-check"></i> Silencios</span>
                        <h5 class="mt-2 mb-1">Control de ruido</h5>
                        <p class="muted mb-0">Silencia categorías o define prioridades por usuario.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Performance -->
              <div class="tab-pane fade" id="wn-perf" role="tabpanel">
                <h3 class="wn-section-title">Rendimiento</h3>
                <div class="row g-3">
                  <div class="col-md-12">
                    <div class="feature-card">
                      <img class="feature-media" src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1200&auto=format&fit=crop" alt="Perf">
                      <div class="feature-body">
                        <span class="chip"><i class="bi bi-speedometer2"></i> +28%</span>
                        <h5 class="mt-2 mb-1">Consultas SQL optimizadas</h5>
                        <p class="muted mb-0">Menos lecturas lógicas, mejores índices y reducción de TTFB en listas grandes.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </section>

        </div>

        <!-- Footer -->
        <div class="wn-footer d-flex justify-content-between align-items-center">
          <div class="muted">
            Publicado: <strong>Agosto 2025</strong> · Compatibilidad: <strong>es-DO</strong>
          </div>
          <div>
            <button id="btnBack" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Portada</button>
            <button class="btn btn-primary" data-bs-dismiss="modal">Entendido</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
    (() => {
        const modalEl = document.getElementById('modalNovedades');
        const modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });

        const stepHero = document.getElementById('step-hero');
        const stepContent = document.getElementById('step-content');
        const btnGo = document.getElementById('btnGo');
        const btnBack = document.getElementById('btnBack');

        document.addEventListener('DOMContentLoaded', () => modal.show());
        btnGo.addEventListener('click', () => {
            stepHero.classList.add('d-none');
            stepContent.classList.remove('d-none');
        });
        btnBack.addEventListener('click', () => {
            stepContent.classList.add('d-none');
            stepHero.classList.remove('d-none');
        });
    })();
</script>

</body>
<script src="../Recursos/Javascript/scripts_master.js" type="text/javascript" charset="ISO-8859-1"></script>
</html>
